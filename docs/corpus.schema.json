{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sebastian-software/ferralk/blob/main/docs/corpus.schema.json",
  "title": "ferralk corpus case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "pattern", "path", "expected", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "kind": { "enum": ["matcher", "has_wildcards", "match_paths", "match_paths_at", "match_path_indices", "match_path_indices_at", "compile_error", "match_glob_path", "absolute_pattern"], "default": "matcher" },
    "paths": { "type": "array", "items": { "type": "string" }, "default": [] },
    "matches": { "type": "array", "items": { "type": "string" }, "default": [] },
    "oracle_matches": { "type": "array", "items": { "type": "string" } },
    "base_path": { "type": "string", "default": "" },
    "rewritten": { "type": "string" },
    "windows_paths": { "type": "boolean", "default": false },
    "indices": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "default": [] },
    "oracle_indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "pattern": { "type": "string" },
    "path": { "type": "string" },
    "flags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
    "ignore_rules": { "type": "array", "items": { "type": "string" }, "default": [] },
    "exclude_rules": { "type": "array", "items": { "type": "string" }, "default": [] },
    "candidate_is_dir": { "type": "boolean", "default": false },
    "git_ignorecase": { "type": "boolean", "default": false },
    "nested_ignore_rules": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directory", "rules"],
        "properties": {
          "directory": { "type": "string" },
          "rules": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "expected": { "type": "boolean" },
    "oracle_expected": { "type": "boolean" },
    "error_offset": { "type": "integer", "minimum": 0 },
    "error_message": { "type": "string" },
    "platform": { "enum": ["posix", "windows"] },
    "source": { "enum": ["zlob_1_6_3", "fast_glob", "git_check_ignore", "handwritten"] },
    "disputed": { "type": "boolean", "default": false },
    "note": { "type": "string" }
  }
}
