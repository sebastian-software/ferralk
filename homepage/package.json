{
  "name": "ferralk-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/write-site-data.mjs && ardo dev",
    "build": "node scripts/write-site-data.mjs && ardo build && node scripts/verify-build.mjs",
    "preview": "ardo preview",
    "lint": "node scripts/write-site-data.mjs && oxlint -c oxlint.config.ts && eslint . --max-warnings=0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "node scripts/write-site-data.mjs && tsc --noEmit",
    "sample:write": "node scripts/render-home-samples.mjs",
    "sample:check": "node scripts/render-home-samples.mjs --check",
    "browser:check": "node scripts/check-browser.mjs",
    "verify": "pnpm sample:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm browser:check"
  },
  "dependencies": {
    "ardo": "^6.6.0",
    "ferramenta-family": "3.0.0"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "eslint": "^10.11.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
