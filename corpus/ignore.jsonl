{"id":"ignore-001","pattern":"*.log","path":"debug.log","flags":[],"ignore_rules":["*.log"],"expected":true,"source":"git_check_ignore","note":"Basic suffix rule."}
{"id":"ignore-002","pattern":"*.log","path":"important.log","flags":[],"ignore_rules":["*.log","!important.log"],"expected":false,"source":"git_check_ignore","note":"A later negation re-includes the file."}
{"id":"ignore-003","pattern":"build/","path":"build/main.o","flags":[],"ignore_rules":["build/"],"expected":true,"source":"git_check_ignore","note":"Directory rule applies to descendants."}
{"id":"ignore-004","pattern":"/root.txt","path":"root.txt","flags":[],"ignore_rules":["/root.txt","src/temp.o"],"expected":true,"source":"git_check_ignore","note":"Frozen zlob gitignore suite: anchored root rule."}
{"id":"ignore-005","pattern":"/root.txt","path":"subdir/root.txt","flags":[],"ignore_rules":["/root.txt","src/temp.o"],"expected":false,"source":"git_check_ignore","note":"Frozen zlob gitignore suite: root rule does not match descendants."}
{"id":"ignore-006","pattern":"src/temp.o","path":"src/temp.o","flags":[],"ignore_rules":["/root.txt","src/temp.o"],"expected":true,"source":"git_check_ignore","note":"Frozen zlob gitignore suite: slash-bearing rule is root-relative."}
{"id":"ignore-007","pattern":"src/temp.o","path":"other/src/temp.o","flags":[],"ignore_rules":["/root.txt","src/temp.o"],"expected":false,"source":"git_check_ignore","note":"Frozen zlob gitignore suite: root-relative rule excludes only its exact prefix."}
{"id":"ignore-008","pattern":"**/logs","path":"app/server/logs/file.txt","flags":[],"ignore_rules":["**/logs","src/**/*.o"],"expected":true,"source":"git_check_ignore","note":"Frozen zlob gitignore suite: recursive directory rule."}
{"id":"ignore-009","pattern":"src/**/*.o","path":"src/a/b/c/deep.o","flags":[],"ignore_rules":["**/logs","src/**/*.o"],"expected":true,"source":"git_check_ignore","note":"Frozen zlob gitignore suite: recursive suffix below a literal root."}
{"id":"ignore-010","pattern":"src/**/*.o","path":"other/main.o","flags":[],"ignore_rules":["**/logs","src/**/*.o"],"expected":false,"source":"git_check_ignore","note":"Frozen zlob gitignore suite: literal root prevents unrelated match."}
{"id":"ignore-011","pattern":"!*.*","path":"src/deep/a.txt","flags":[],"ignore_rules":["*","!*.*","!/**/"],"expected":false,"source":"git_check_ignore","note":"Frozen zlob allowlist idiom, verified by Git: extensioned nested file is re-included."}
{"id":"ignore-012","pattern":"*","path":"src/noext","flags":[],"ignore_rules":["*","!*.*","!/**/"],"expected":true,"source":"git_check_ignore","note":"Frozen zlob allowlist idiom: extensionless nested file stays ignored."}
{"id":"ignore-013","pattern":"a/**/b","path":"a/x/y/b","flags":[],"ignore_rules":["**/*.c","a/**/b"],"expected":true,"source":"git_check_ignore","note":"Frozen zlob gitignore suite: recursive middle segment."}
{"id":"ignore-014","pattern":"!keep.log","path":"sub/keep.log","flags":[],"ignore_rules":["*.log"],"nested_ignore_rules":[{"directory":"sub","rules":["!keep.log"]}],"expected":false,"source":"git_check_ignore","note":"A nested .gitignore re-includes what the root excluded: Git reads the file closest to the candidate last."}
{"id":"ignore-015","pattern":"!keep.log","path":"sub/other.log","flags":[],"ignore_rules":["*.log"],"nested_ignore_rules":[{"directory":"sub","rules":["!keep.log"]}],"expected":true,"source":"git_check_ignore","note":"The nested negation names one file, so its siblings stay excluded by the root rule."}
{"id":"ignore-016","pattern":"*.tmp","path":"sub/a.tmp","flags":[],"ignore_rules":[],"nested_ignore_rules":[{"directory":"sub","rules":["*.tmp"]}],"expected":true,"source":"git_check_ignore","note":"A nested file may add a rule the root never had."}
{"id":"ignore-017","pattern":"*.tmp","path":"other/a.tmp","flags":[],"ignore_rules":[],"nested_ignore_rules":[{"directory":"sub","rules":["*.tmp"]}],"expected":false,"source":"git_check_ignore","note":"A nested rule applies only below its own directory."}
{"id":"ignore-018","pattern":"*.log","path":"sub/deep/a.log","flags":[],"ignore_rules":["*.log"],"nested_ignore_rules":[{"directory":"sub","rules":["!*.log"]},{"directory":"sub/deep","rules":["*.log"]}],"expected":true,"source":"git_check_ignore","note":"Three levels disagree; the deepest file wins, so the candidate is ignored again."}
{"id":"ignore-019","pattern":"!build/keep.txt","path":"build/keep.txt","flags":[],"ignore_rules":["build/","!build/keep.txt"],"expected":true,"source":"git_check_ignore","note":"Git cannot re-include a file whose parent directory is excluded, so the negation has no effect."}
{"id":"ignore-020","pattern":"!build/keep.txt","path":"build/keep.txt","flags":[],"ignore_rules":["build/*","!build/keep.txt"],"expected":false,"source":"git_check_ignore","note":"Excluding the directory's contents rather than the directory itself leaves the negation effective."}
{"id":"ignore-021","pattern":"!logs/keep/**","path":"logs/keep/a.txt","flags":[],"ignore_rules":["logs/**","!logs/keep/","!logs/keep/**"],"expected":false,"source":"git_check_ignore","note":"Re-including a subtree needs both the directory and its contents named."}
{"id":"ignore-022","pattern":"*.log ","path":"a.log","flags":[],"ignore_rules":["*.log "],"expected":true,"source":"git_check_ignore","note":"Git strips unescaped trailing whitespace from a rule."}
{"id":"ignore-023","pattern":"a\\x5C .log","path":"a .log","flags":[],"ignore_rules":["a\\ .log"],"expected":true,"source":"git_check_ignore","note":"A backslash-escaped trailing space is part of the rule and matches a name that ends in one."}
{"id":"ignore-024","pattern":"\\x5C!important.log","path":"!important.log","flags":[],"ignore_rules":["\\!important.log"],"expected":true,"source":"git_check_ignore","note":"A leading bang can be escaped, making the rule an ordinary exclusion of a file named with one."}
{"id":"ignore-025","pattern":"# *.log","path":"a.log","flags":[],"ignore_rules":["# *.log","*.tmp"],"expected":false,"source":"git_check_ignore","note":"A line starting with # is a comment, not a rule."}
{"id":"ignore-026","pattern":"*.tmp","path":"a.tmp","flags":[],"ignore_rules":["","*.tmp"],"expected":true,"source":"git_check_ignore","note":"A blank line separates rules and matches nothing itself."}
{"id":"ignore-027","pattern":"**/build","path":"a/b/build/x.o","flags":[],"ignore_rules":["**/build"],"expected":true,"source":"git_check_ignore","note":"A leading **/ matches the directory at any depth."}
{"id":"ignore-028","pattern":"src/**","path":"src/a/b/c.o","flags":[],"ignore_rules":["src/**"],"expected":true,"source":"git_check_ignore","note":"A trailing /** matches everything below the directory."}
{"id":"ignore-029","pattern":"a/**/z","path":"a/b/c/z","flags":[],"ignore_rules":["a/**/z"],"expected":true,"source":"git_check_ignore","note":"A middle /**/ spans any number of directories."}
{"id":"ignore-030","pattern":"a/**/z","path":"a/z","flags":[],"ignore_rules":["a/**/z"],"expected":true,"source":"git_check_ignore","note":"A middle /**/ also spans zero directories, unlike the matcher's component-local reading."}
{"id":"ignore-031","pattern":"*.[oa]","path":"main.o","flags":[],"ignore_rules":["*.[oa]"],"expected":true,"source":"git_check_ignore","note":"Character classes are available in ignore rules."}
{"id":"ignore-032","pattern":"*.[oa]","path":"main.c","flags":[],"ignore_rules":["*.[oa]"],"expected":false,"source":"git_check_ignore","note":"A byte outside the class does not match."}
{"id":"ignore-033","pattern":"file[!0-9].txt","path":"filex.txt","flags":[],"ignore_rules":["file[!0-9].txt"],"expected":true,"source":"git_check_ignore","note":"Negated classes use the same ! spelling as the matcher."}
{"id":"ignore-034","pattern":"*.[[:digit:]]","path":"a.7","flags":[],"ignore_rules":["*.[[:digit:]]"],"expected":true,"source":"git_check_ignore","note":"POSIX class names work inside ignore rules."}
{"id":"ignore-035","pattern":"temp","path":"src/deep/temp","flags":[],"ignore_rules":["temp"],"expected":true,"source":"git_check_ignore","note":"A rule without a slash matches the basename at any depth."}
{"id":"ignore-036","pattern":"/temp","path":"src/deep/temp","flags":[],"ignore_rules":["/temp"],"expected":false,"source":"git_check_ignore","note":"A leading slash anchors the rule to the repository root."}
{"id":"ignore-037","pattern":"src/temp","path":"src/temp","flags":[],"ignore_rules":["src/temp"],"expected":true,"source":"git_check_ignore","note":"A slash anywhere but at the end anchors the rule to the root."}
{"id":"ignore-038","pattern":"src/temp","path":"a/src/temp","flags":[],"ignore_rules":["src/temp"],"expected":false,"source":"git_check_ignore","note":"The same rule therefore does not match the identical suffix deeper down."}
{"id":"ignore-039","pattern":"cache/","path":"cache","flags":[],"ignore_rules":["cache/"],"expected":false,"source":"git_check_ignore","note":"A trailing slash restricts the rule to directories, and this candidate is a regular file."}
{"id":"ignore-040","pattern":"cache/","path":"cache/a.txt","flags":[],"ignore_rules":["cache/"],"expected":true,"source":"git_check_ignore","note":"The same rule ignores everything inside the directory it names."}
{"id":"ignore-041","pattern":"file?.txt","path":"filex.txt","flags":[],"ignore_rules":["file?.txt"],"expected":true,"source":"git_check_ignore","note":"A question mark matches one byte in an ignore rule too."}
{"id":"ignore-042","pattern":"a?c","path":"a/c","flags":[],"ignore_rules":["a?c"],"expected":false,"source":"git_check_ignore","note":"Wildcards in an ignore rule never match a separator, unlike the fnmatch-style matcher."}
{"id":"ignore-043","pattern":"a*c","path":"a/b/c","flags":[],"ignore_rules":["a*c"],"expected":false,"source":"git_check_ignore","note":"A star in an ignore rule stays inside one path component."}
{"id":"ignore-044","pattern":"*.tmp","path":"scratch.tmp","flags":[],"ignore_rules":[],"exclude_rules":["*.tmp"],"expected":true,"source":"git_check_ignore","note":"Repository excludes in .git/info/exclude apply like a root rule."}
{"id":"ignore-045","pattern":"!keep.tmp","path":"keep.tmp","flags":[],"ignore_rules":["!keep.tmp"],"exclude_rules":["*.tmp"],"expected":false,"source":"git_check_ignore","note":"The root .gitignore outranks .git/info/exclude."}
{"id":"ignore-046","pattern":"!keep.log","path":"sub/keep.log","flags":[],"ignore_rules":[],"nested_ignore_rules":[{"directory":"sub","rules":["!keep.log"]}],"exclude_rules":["*.log"],"expected":false,"source":"git_check_ignore","note":"A nested .gitignore outranks .git/info/exclude as well."}
{"id":"ignore-047","pattern":"file[[:upper:]].txt","path":"fileA.txt","flags":[],"ignore_rules":["file[[:upper:]].txt"],"expected":true,"source":"git_check_ignore","note":"A POSIX class name inside a bracket expression, matching."}
{"id":"ignore-048","pattern":"file[[:upper:]].txt","path":"filea.txt","flags":[],"ignore_rules":["file[[:upper:]].txt"],"expected":false,"source":"git_check_ignore","note":"The same class, not matching: the class is read, not taken literally."}
{"id":"ignore-049","pattern":"*.{ts,tsx}","path":"a.ts","flags":[],"ignore_rules":["*.{ts,tsx}"],"expected":false,"source":"git_check_ignore","note":"Git does not expand braces in ignore rules."}
{"id":"ignore-050","pattern":"*.{ts,tsx}","path":"a.{ts,tsx}","flags":[],"ignore_rules":["*.{ts,tsx}"],"expected":true,"source":"git_check_ignore","note":"The braces are literal, so the literal name matches."}
{"id":"ignore-051","pattern":"foo","path":"xfoo","flags":[],"ignore_rules":["foo"],"expected":false,"source":"git_check_ignore","note":"An unanchored rule matches a whole component, not a suffix of one."}
{"id":"ignore-052","pattern":"a/**/b","path":"a/xb","flags":[],"ignore_rules":["a/**/b"],"expected":false,"source":"git_check_ignore","note":"A double star in a rule spans whole components only."}
{"id":"ignore-053","pattern":"a**b","path":"a/x/b","flags":[],"ignore_rules":["a**b"],"expected":false,"source":"git_check_ignore","note":"Asterisks that are not a whole component are ordinary stars."}
{"id":"ignore-054","pattern":"a**b","path":"axxb","flags":[],"ignore_rules":["a**b"],"expected":true,"source":"git_check_ignore","note":"The same run, inside one component."}
{"id":"ignore-055","pattern":"abc/**","path":"abc","flags":[],"ignore_rules":["abc/**"],"expected":false,"source":"git_check_ignore","note":"A trailing double star covers what is inside, not the directory itself."}
{"id":"ignore-056","pattern":"trailing\\x5C ","path":"trailing ","flags":[],"ignore_rules":["trailing\\ "],"expected":true,"source":"git_check_ignore","note":"An escaped trailing space is part of the name."}
{"id":"ignore-057","pattern":"foo\\x5C","path":"foo","flags":[],"ignore_rules":["foo\\"],"expected":false,"source":"git_check_ignore","note":"A rule ending in an unpaired backslash matches nothing."}
{"id":"ignore-058","pattern":"a//b","path":"a/b","flags":[],"ignore_rules":["a//b"],"expected":false,"source":"git_check_ignore","note":"A doubled separator creates an empty component, which Git treats as unmatchable."}
{"id":"ignore-059","pattern":"//foo","path":"foo","flags":[],"ignore_rules":["//foo"],"expected":false,"source":"git_check_ignore","note":"Only one leading slash is an anchor; the second creates an unmatchable empty component."}
{"id":"ignore-060","pattern":"x///y","path":"x/y","flags":[],"ignore_rules":["x///y"],"expected":false,"source":"git_check_ignore","note":"Repeated interior separators create empty components and cannot hide a real path."}
{"id":"ignore-061","pattern":"sec","path":"sec","flags":[],"ignore_rules":["sec\u0000ret.txt"],"expected":true,"source":"git_check_ignore","note":"Git truncates an ignore rule at its first NUL byte."}
{"id":"ignore-062","pattern":"sec","path":"secret.txt","flags":[],"ignore_rules":["sec\u0000ret.txt"],"expected":false,"source":"git_check_ignore","note":"The text after a NUL is not part of the ignore rule."}
{"id":"ignore-063","pattern":"\uFEFFdouble.txt","path":"\uFEFFdouble.txt","flags":[],"ignore_rules":["\uFEFF\uFEFFdouble.txt"],"expected":true,"source":"git_check_ignore","note":"Git strips exactly one initial UTF-8 BOM, leaving a second BOM as part of the rule."}
